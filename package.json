{
  "name": "gladys-noaa-space-weather",
  "version": "0.1.1",
  "private": true,
  "description": "External Gladys Assistant integration for the space weather of the NOAA SWPC: Kp index, NOAA scales, solar wind, flares, aurora forecast per house, SWPC alerts, scene triggers, dashboard widgets (not affiliated with NOAA).",
  "homepage": "https://github.com/William-De71/gladys-noaa-space-weather",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/William-De71/gladys-noaa-space-weather.git"
  },
  "type": "module",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@gladysassistant/integration-sdk": "^0.15.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10"
  },
  "license": "Apache-2.0",
  "keywords": [
    "gladys-assistant",
    "gladys-assistant-integration",
    "noaa",
    "swpc",
    "space-weather",
    "aurora",
    "kp-index",
    "solar-flare",
    "home-automation"
  ]
}
